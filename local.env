# URL for Elasticsearch : local (no security enabled)
ELASTICSEARCH_URL=http://localhost:9200

DOCUMENT_INDEX = 'dots_document'
COLLECTION_INDEX = 'dots_collection'
TARGET_COLLECTION = 'ENCPOS_1849'
# Declare the relative path between the app folder and the custom collection settings folder
ES_CLI_CUSTOM_SETTINGS_PATH=${CUSTOM_SETTINGS_PATH}
ADDITIONAL_EXCLUDED_COLLECTIONS=corpus, bfm, cid, cartulaires, ENCPOS, encpos_2, theater, CLEM, cjc, formulaires, dubourg, miroir, comptes, obituaires, sanctoral_elec
# fulllist cid, cartulaires, ENCPOS, ENCPOS_2, CLEM, theater, CJC, formulaires, dubourg, miroir, comptes, obituaires, sanctoral_elec
# Encpos specific to adapt : ALL_YEARS=1849-2023
DTS_URL = https://dev.chartes.psl.eu/dots/api/dts

SEARCH_RESULT_PER_PAGE = 200
