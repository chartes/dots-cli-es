{
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "type": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "resource_id": {
        "type": "keyword"
      },

      "passage_id": {
        "type": "keyword"
      },

      "citeType": {
        "type": "keyword"
      },

      "level": {
        "type": "integer"
      },

      "content": {
        "type": "text",
        "analyzer": "folding",
        "term_vector": "with_positions_offsets"
      },

      "path": {
        "type": "keyword"
      },

      "path_ids": {
        "type": "keyword"
      },

      "ancestors": {
        "type": "nested",
        "properties": {
          "id": { "type": "keyword" },
          "level": { "type": "integer" },
          "citeType": { "type": "keyword" }
        }
      },

      "collection_metadata": {
        "type": "object",
        "dynamic": true
      },
      "resource_metadata": {
        "type": "object",
        "dynamic": true
      }
    }
  }
}
